        "# 2. Statistical Summary\n",
        "print(\"\\n--- Statistical Summary of Numeric Features ---\")\n",
        "print(df[['tenure', 'MonthlyCharges', 'TotalCharges']].describe())\n",
        "\n",
        "# 3. Visualize Outliers using Boxplots\n",
        "plt.figure(figsize=(15, 5))\n",
        "features = ['tenure', 'MonthlyCharges', 'TotalCharges']\n",
        "for i, col in enumerate(features):\n",
        "    plt.subplot(1, 3, i+1)\n",
        "    sns.boxplot(x=df[col], color='lightgreen')\n",
        "    plt.title(f'Boxplot of {col}')\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# 4. Remove Outliers using IQR Method\n",
        "def remove_outliers_iqr(df, columns):\n",
        "    for col in columns:\n",
        "        Q1 = df[col].quantile(0.25)\n",
        "        Q3 = df[col].quantile(0.75)\n",
        "        IQR = Q3 - Q1\n",
        "        lower_bound = Q1 - 1.5 * IQR\n",
        "        upper_bound = Q3 + 1.5 * IQR\n",
        "\n",
        "        # Initial count\n",
        "        initial_count = df.shape[0]\n",
        "        df = df[(df[col] >= lower_bound) & (df[col] <= upper_bound)]\n",
        "        print(f\"Removed {initial_count - df.shape[0]} outliers from {col}\")\n",
        "    return df\n",
        "\n",
        "df = remove_outliers_iqr(df, ['tenure', 'MonthlyCharges', 'TotalCharges'])\n",
        "\n",
        "print(f\"\\nFinal shape after cleaning: {df.shape}\")"
